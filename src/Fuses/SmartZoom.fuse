--[[--
Smart Zoom & Zoom Generator - Suite DaVinci Resolve
Gestion dynamique et visuelle du zoom avec aperçu graphique et Timeline interactive.
--]]--

FuRegisterClass("SmartZoom", CT_Tool, {
	REGS_Name          = "Smart Zoom",
	REGS_Category      = "Fuses\\Transform",
	REGS_OpIconString  = "SZ",
	REGS_OpDescription = "Courbes de zoom et timeline dynamique sur plan",
	REGS_HelpTopic     = "Smart Zoom",
	REG_OpNoMask       = false,
	REG_NoBlendCtrls   = false,
	REG_NoObjMatCtrls  = true,
	REG_NoMotionBlurCtrls = false,
	REG_Fuse_NoEdit    = false,
	REG_Fuse_NoReload  = false,
	REG_Version        = 107,
})

local CURVE_ORANGE = {
	[0] = "",
	[1] = "",
	[2] = "",
	[3] = "",
	[4] = "",
	[5] = "",
	[6] = "",
}

local CURVE_BLUE = {
	[0] = "",
	[1] = "",
	[2] = "",
	[3] = "",
	[4] = "",
	[5] = "",
	[6] = "",
}

local function get_preview_html_orange(style_id)
	local b64 = CURVE_ORANGE[style_id] or CURVE_ORANGE[1]
	return string.format("<table width='100%%' cellspacing='0' cellpadding='0'><tr><td align='center'><img src='data:image/png;base64,%s' width='280' height='103'></td></tr></table>", b64)
end

local function get_preview_html_blue(style_id)
	local b64 = CURVE_BLUE[style_id] or CURVE_BLUE[1]
	return string.format("<table width='100%%' cellspacing='0' cellpadding='0'><tr><td align='center'><img src='data:image/png;base64,%s' width='280' height='103'></td></tr></table>", b64)
end

function Create()
	---------------------------------------------------------------------------
	-- SECTION 1 : APERÇU DE LA COURBE & TYPE DE COURBE
	---------------------------------------------------------------------------
	self:BeginControlNest("📈 Forme de la Courbe", "CurveNest", true)

	InCurvePreview = self:AddInput(get_preview_html_orange(1), "CurvePreview", {
		LINKID_DataType    = "Number",
		INPID_InputControl = "LabelControl",
		LBLC_MultiLine     = true,
		INP_External       = false,
		INP_Passive        = true,
		IC_NoLabel         = true,
		INP_DoNotifyChanged = true,
		ICS_ControlPage    = "Controls",
	})

	InCurvePreviewOrange = self:AddInput(get_preview_html_orange(1), "CurvePreviewOrange", {
		LINKID_DataType    = "Number",
		INPID_InputControl = "LabelControl",
		LBLC_MultiLine     = true,
		INP_External       = false,
		INP_Passive        = true,
		IC_NoLabel         = true,
		INP_DoNotifyChanged = true,
		ICS_ControlPage    = "Controls",
	})

	InCurvePreviewBlue = self:AddInput(get_preview_html_blue(1), "CurvePreviewBlue", {
		LINKID_DataType    = "Number",
		INPID_InputControl = "LabelControl",
		LBLC_MultiLine     = true,
		INP_External       = false,
		INP_Passive        = true,
		IC_NoLabel         = true,
		INP_DoNotifyChanged = true,
		ICS_ControlPage    = "Controls",
	})

	InCurveStyle = self:AddInput("Type de Courbe", "CurveStyle", {
		LINKID_DataType    = "Number",
		INPID_InputControl = "ComboControl",
		INP_Default        = 1, -- Douce par défaut
		INP_Integer        = true,
		INP_DoNotifyChanged = true,
		ICS_ControlPage    = "Controls",
		{ CCS_AddString = "Snap / Punchy" },
		{ CCS_AddString = "Douce (S-Curve)" },
		{ CCS_AddString = "Whip Zoom" },
		{ CCS_AddString = "Ressort (Bounce)" },
		{ CCS_AddString = "Lineaire" },
		{ CCS_AddString = "Acceleration Lente" },
		{ CCS_AddString = "Punch-In & Retour" },
	})

	InOvershootAmount = self:AddInput("Force du Ressort (Bounce)", "OvershootAmount", {
		LINKID_DataType    = "Number",
		INPID_InputControl = "SliderControl",
		INP_MinScale       = 0.5,
		INP_MaxScale       = 3.5,
		INP_Default        = 1.70,
		ICS_ControlPage    = "Controls",
	})

	self:EndControlNest()

	---------------------------------------------------------------------------
	-- SECTION 2 : TIMING & PLACEMENT (Mini Timeline RangeControl)
	---------------------------------------------------------------------------
	self:BeginControlNest("⏱️ Placement & Timing", "TimingNest", true)

	InTimingPreset = self:AddInput("Preset Timing", "TimingPreset", {
		LINKID_DataType    = "Number",
		INPID_InputControl = "ComboControl",
		INP_Default        = 1, -- Début : Premier Tiers (0% -> 33%)
		INP_Integer        = true,
		ICS_ControlPage    = "Controls",
		{ CCS_AddString = "Personnalisé (Curseurs ci-dessous)" },
		{ CCS_AddString = "Début : Premier Tiers (0% → 33%)" },
		{ CCS_AddString = "Début : Première Moitié (0% → 50%)" },
		{ CCS_AddString = "Fin : Seconde Moitié (50% → 100%)" },
		{ CCS_AddString = "Fin : Dernier Tiers (66% → 100%)" },
		{ CCS_AddString = "Milieu : Punch Central (25% → 75%)" },
		{ CCS_AddString = "Impact Flash (0% → 15%)" },
		{ CCS_AddString = "Tout le Plan (0% → 100%)" },
	})

	InStartPercent = self:AddInput("Timeline", "StartPercent", {
		LINKID_DataType    = "Number",
		INPID_InputControl = "RangeControl",
		INP_MinScale       = 0.0,
		INP_MaxScale       = 100.0,
		INP_Default        = 0.0,
		INP_Integer        = false,
		IC_ControlGroup    = 1,
		IC_ControlID       = 0,
		ICS_ControlPage    = "Controls",
	})

	InEndPercent = self:AddInput("Fin", "EndPercent", {
		LINKID_DataType    = "Number",
		INPID_InputControl = "RangeControl",
		INP_MinScale       = 0.0,
		INP_MaxScale       = 100.0,
		INP_Default        = 33.33,
		INP_Integer        = false,
		IC_ControlGroup    = 1,
		IC_ControlID       = 1,
		ICS_ControlPage    = "Controls",
	})

	InReverseTiming = self:AddInput("Inverser le sens temporel", "ReverseTiming", {
		LINKID_DataType    = "Number",
		INPID_InputControl = "CheckboxControl",
		INP_Default        = 0.0,
		ICS_ControlPage    = "Controls",
	})

	self:EndControlNest()

	---------------------------------------------------------------------------
	-- SECTION 3 : PARAMÈTRES DE ZOOM & CADRAGE
	---------------------------------------------------------------------------
	self:BeginControlNest("🔍 Cadrage & Zoom", "ZoomNest", true)

	InZoomMode = self:AddInput("Sens du Zoom", "ZoomMode", {
		LINKID_DataType    = "Number",
		INPID_InputControl = "ComboControl",
		INP_Default        = 0,
		INP_Integer        = true,
		ICS_ControlPage    = "Controls",
		{ CCS_AddString = "Zoom Avant (Punch In)" },
		{ CCS_AddString = "Zoom Arrière (Pull Out)" },
	})

	InZoomStart = self:AddInput("Échelle Initiale", "ZoomStart", {
		LINKID_DataType    = "Number",
		INPID_InputControl = "SliderControl",
		INP_MinScale       = 0.5,
		INP_MaxScale       = 3.0,
		INP_Default        = 1.0,
		ICS_ControlPage    = "Controls",
	})

	InZoomTarget = self:AddInput("Échelle Cible (Zoom)", "ZoomTarget", {
		LINKID_DataType    = "Number",
		INPID_InputControl = "SliderControl",
		INP_MinScale       = 1.0,
		INP_MaxScale       = 4.0,
		INP_Default        = 1.35,
		ICS_ControlPage    = "Controls",
	})

	InTargetPivot = self:AddInput("Cible / Point d'intérêt", "TargetPivot", {
		LINKID_DataType      = "Point",
		INPID_InputControl   = "OffsetControl",
		INPID_PreviewControl = "CrosshairControl",
		INP_DefaultX         = 0.5,
		INP_DefaultY         = 0.5,
		XF_Axis              = true,
		ICS_ControlPage      = "Controls",
	})

	InFramingMode = self:AddInput("Mode de Cadrage", "FramingMode", {
		LINKID_DataType    = "Number",
		INPID_InputControl = "ComboControl",
		INP_Default        = 0,
		INP_Integer        = true,
		ICS_ControlPage    = "Controls",
		{ CCS_AddString = "Centrer le sujet à l'écran" },
		{ CCS_AddString = "Garder le sujet à son emplacement initial" },
	})

	InEdgeMode = self:AddInput("Gestion des Bords", "EdgeMode", {
		LINKID_DataType    = "Number",
		INPID_InputControl = "ComboControl",
		INP_Default        = 0,
		INP_Integer        = true,
		ICS_ControlPage    = "Controls",
		{ CCS_AddString = "Dupliquer les bords (Anti-bandes noires)" },
		{ CCS_AddString = "Fond Noir (Canvas)" },
		{ CCS_AddString = "Tuilage (Wrap)" },
	})

	self:EndControlNest()

	---------------------------------------------------------------------------
	-- SECTION 4 : ROTATION SUBTILE (Optionnelle)
	---------------------------------------------------------------------------
	self:BeginControlNest("🌀 Rotation Dynamique (Optionnel)", "AngleNest", false)

	InAngle = self:AddInput("Angle de Rotation (°)", "Angle", {
		LINKID_DataType    = "Number",
		INPID_InputControl = "SliderControl",
		INP_MinScale       = -15.0,
		INP_MaxScale       = 15.0,
		INP_Default        = 0.0,
		ICS_ControlPage    = "Controls",
	})

	self:EndControlNest()

	---------------------------------------------------------------------------
	-- ENTRÉES / SORTIES
	---------------------------------------------------------------------------
	InImage = self:AddInput("Input", "Input", {
		LINKID_DataType = "Image",
		LINK_Main       = 1,
	})

	OutImage = self:AddOutput("Output", "Output", {
		LINKID_DataType = "Image",
		LINK_Main       = 1,
	})
end

function OnAddToCmd()
	local style_id = 1
	if InCurveStyle then
		pcall(function()
			style_id = math.floor(InCurveStyle:GetValue(self.Comp.CurrentTime).Value + 0.5)
		end)
	end
	local html_o = get_preview_html_orange(style_id)
	local html_b = get_preview_html_blue(style_id)
	if InCurvePreview then
		InCurvePreview:SetAttrs({ LINKS_Name = html_o, IC_Visible = true })
	end
	if InCurvePreviewOrange then
		InCurvePreviewOrange:SetAttrs({ LINKS_Name = html_o, IC_Visible = true })
	end
	if InCurvePreviewBlue then
		InCurvePreviewBlue:SetAttrs({ LINKS_Name = html_b, IC_Visible = true })
	end
end

function NotifyChanged(inp, param, time)
	if inp == InCurveStyle and param then
		local style_id = math.floor(param.Value + 0.5)
		local html_o = get_preview_html_orange(style_id)
		local html_b = get_preview_html_blue(style_id)
		if InCurvePreview then
			InCurvePreview:SetAttrs({ LINKS_Name = html_o, IC_Visible = true })
		end
		if InCurvePreviewOrange then
			InCurvePreviewOrange:SetAttrs({ LINKS_Name = html_o, IC_Visible = true })
		end
		if InCurvePreviewBlue then
			InCurvePreviewBlue:SetAttrs({ LINKS_Name = html_b, IC_Visible = true })
		end
	end
end

-------------------------------------------------------------------------------
-- CALCUL DE LA PROGRESSION TEMPORELLE
-------------------------------------------------------------------------------
local function compute_progress(time, r_start, r_end, preset_id, custom_start, custom_end, reverse)
	local duration = r_end - r_start
	if duration <= 0 then duration = 1 end

	local t_norm = (time - r_start) / duration
	if reverse > 0.5 then
		t_norm = 1.0 - t_norm
	end

	local s = 0.0
	local e = 1.0

	if preset_id == 1 then     -- Premier Tiers
		s = 0.0; e = 0.3333
	elseif preset_id == 2 then -- Première Moitié
		s = 0.0; e = 0.50
	elseif preset_id == 3 then -- Seconde Moitié
		s = 0.50; e = 1.0
	elseif preset_id == 4 then -- Dernier Tiers
		s = 0.6667; e = 1.0
	elseif preset_id == 5 then -- Milieu
		s = 0.25; e = 0.75
	elseif preset_id == 6 then -- Impact Flash
		s = 0.0; e = 0.15
	elseif preset_id == 7 then -- Tout le plan
		s = 0.0; e = 1.0
	else                       -- Manuel / RangeControl
		s = custom_start / 100.0
		e = custom_end / 100.0
	end

	if e <= s then e = s + 0.0001 end

	local p = 0.0
	if t_norm <= s then
		p = 0.0
	elseif t_norm >= e then
		p = 1.0
	else
		p = (t_norm - s) / (e - s)
	end

	return p
end

-------------------------------------------------------------------------------
-- APPLICATION DES COURBES D'ATTÉNUATION (EASING)
-------------------------------------------------------------------------------
local function evaluate_curve(p, style_id, overshoot_k)
	if style_id == 0 then
		-- Punchy Snap (Cubic Ease Out)
		local inv = 1.0 - p
		return 1.0 - (inv * inv * inv)

	elseif style_id == 1 then
		-- Douce (S-Curve / Sine Ease In-Out)
		return 0.5 * (1.0 - math.cos(p * math.pi))

	elseif style_id == 2 then
		-- Whip (Exponential Out)
		if p >= 1.0 then return 1.0 end
		return 1.0 - math.pow(2.0, -10.0 * p)

	elseif style_id == 3 then
		-- Ressort / Bounce (Back Ease Out)
		local c1 = overshoot_k or 1.70158
		local c3 = c1 + 1.0
		local u = p - 1.0
		return 1.0 + c3 * (u * u * u) + c1 * (u * u)

	elseif style_id == 4 then
		-- Linéaire
		return p

	elseif style_id == 5 then
		-- Accélération lente (Cubic In)
		return p * p * p

	elseif style_id == 6 then
		-- Punch-In & Retour (Cloche / Sinus)
		return math.sin(p * math.pi)
	end

	return p
end

-------------------------------------------------------------------------------
-- PROCESS (EXÉCUTÉ PAR FRAME) - 100% SÉCURISÉ CONTRE LES ÉCRANS NOIRS
-------------------------------------------------------------------------------
function Process(req)
	local img = InImage:GetValue(req)
	if not img then
		OutImage:Set(req, nil)
		return
	end

	-- Récupération des limites temporelles
	local time = req.Time
	local r_start = 0
	local r_end = 100

	if self.Comp then
		pcall(function()
			r_start = self.Comp.RenderStart or 0
			r_end = self.Comp.RenderEnd or 100
			if r_end <= r_start then
				r_start = self.Comp.GlobalStart or 0
				r_end = self.Comp.GlobalEnd or 100
			end
		end)
	end

	if r_end <= r_start then
		r_end = r_start + 100
	end

	-- Lecture des paramètres utilisateur
	local preset_id    = InTimingPreset:GetValue(req).Value
	local start_pct    = InStartPercent:GetValue(req).Value
	local end_pct      = InEndPercent:GetValue(req).Value
	local reverse_t    = InReverseTiming:GetValue(req).Value

	local curve_style  = InCurveStyle:GetValue(req).Value
	local overshoot_k  = InOvershootAmount:GetValue(req).Value

	local zoom_mode    = InZoomMode:GetValue(req).Value
	local zoom_start   = InZoomStart:GetValue(req).Value
	local zoom_target  = InZoomTarget:GetValue(req).Value
	local pivot        = InTargetPivot:GetValue(req)
	local framing_mode = InFramingMode:GetValue(req).Value
	local edge_id      = InEdgeMode:GetValue(req).Value
	local angle_deg    = InAngle:GetValue(req).Value

	-- 1. Calcul de la progression
	local progress = compute_progress(time, r_start, r_end, preset_id, start_pct, end_pct, reverse_t)

	-- 2. Évaluation de la courbe
	local curve_val = evaluate_curve(progress, curve_style, overshoot_k)

	-- 3. Inversion si Zoom Arrière
	if zoom_mode == 1 then
		local temp = zoom_start
		zoom_start = zoom_target
		zoom_target = temp
	end

	-- 4. Échelle actuelle
	local current_zoom = zoom_start + (zoom_target - zoom_start) * curve_val
	if current_zoom < 0.01 then current_zoom = 0.01 end

	-- 5. Cadrage
	local offset_x = pivot.X
	local offset_y = pivot.Y

	if framing_mode == 0 then
		offset_x = pivot.X + (0.5 - pivot.X) * curve_val
		offset_y = pivot.Y + (0.5 - pivot.Y) * curve_val
	end

	-- 6. Bords
	local edge_str = "Duplicate"
	if edge_id == 1 then
		edge_str = "Canvas"
	elseif edge_id == 2 then
		edge_str = "Wrap"
	end

	local current_angle = angle_deg * curve_val

	-- 7. Transformation GPU native Fusion avec filet de sécurité absolu
	local ok, out = pcall(function()
		return img:Transform(nil, {
			XF_XOffset  = offset_x,
			XF_YOffset  = offset_y,
			XF_Axis     = { pivot.X, pivot.Y },
			XF_XAxis    = pivot.X,
			XF_YAxis    = pivot.Y,
			XF_XSize    = current_zoom,
			XF_YSize    = current_zoom,
			XF_Angle    = current_angle,
			XF_EdgeMode = edge_str,
		})
	end)

	-- Si échec quelconque, on retourne l'image d'origine pour éviter tout écran noir
	if not ok or not out then
		out = img
	end

	OutImage:Set(req, out)
end
